{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnostic proposal",
  "type": "object",
  "required": ["id", "title", "check", "why", "expected_result", "risk", "status"],
  "properties": { "id": { "type": "string", "pattern": "^prop_" }, "title": { "type": "string" }, "check": { "type": "string" }, "why": { "type": "string" }, "expected_result": { "type": "string" }, "risk": { "enum": ["low", "medium", "high"] }, "status": { "enum": ["pending", "approved", "rejected", "blocked"] } }
}
