# Environment configuration — copy to .env and fill in your values

# ─── LLM API Keys ────────────────────────────────────────────────────────────
# Gemini is the primary LLM. Groq is used as fallback.
# Both are optional: the agents work in stub mode for demo if neither is set.
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-secret

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev_pw@localhost:5432/incident_commander

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
